# BizaNet Control - Variables d'Environnement (Exemple)

# 1. Base de données
# L'URL de connexion vers votre base de données PostgreSQL (ex: Supabase, Vercel Postgres, Neon)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# 2. Sécurité
# Clé secrète pour signer les JWT (JSON Web Tokens). Utilisez une chaîne longue et aléatoire.
# Vous pouvez la générer avec: openssl rand -base64 32
JWT_SECRET="votre_cle_secrete_jwt_super_longue"

# Clé de chiffrement pour les mots de passe des routeurs (MikroTik). DOIT faire 32 caractères.
# Si vous changez cette clé, vous perdrez l'accès aux routeurs existants.
ENCRYPTION_KEY="votre_cle_chiffrement_32_caracteres"

# 3. Automatisation (CRON)
# Clé secrète pour sécuriser les appels à l'API de CRON. À configurer aussi sur Vercel Cron.
CRON_SECRET="cle_secrete_cron_a_definir"

# 4. Réseau & MikroTik
# Mode de connexion réseau: "live" (connexion réelle aux routeurs) ou "mock" (simulation pour le développement)
BIZANET_NETWORK_MODE="mock"

# URL du BizaNet-Agent local (proxy /api/hotspot/create → /hotspot/create-user)
BIZANET_AGENT_URL="http://localhost:4000"
BIZANET_AGENT_API_KEY="BIZANET_LOCAL_2026"
# Profil MikroTik pour les tickets Quick Sale / tokens (ex: standar1, Shared Users = 1)
BIZANET_HOTSPOT_TOKEN_PROFILE="standar1"

# Portail captive hotspot (QR des tickets)
NEXT_PUBLIC_HOTSPOT_LOGIN_BASE_URL="http://login.bizanet"
# POST login MikroTik (formulaire hotspot)
NEXT_PUBLIC_MIKROTIK_LOGIN_ACTION="http://192.168.88.1/login"
# Hôtes du portail hotspot (séparés par virgule)
HOTSPOT_LOGIN_HOSTS="login.bizanet"

# 5. URL de l'Application
# URL publique de votre application en production (ex: https://bizanet-control.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
