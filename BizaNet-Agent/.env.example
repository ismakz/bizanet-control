# Port HTTP de l'agent
PORT=3010

# Sécurité (obligatoire)
AGENT_API_KEY=BIZANET_LOCAL_2026
# JWT interne (optionnel, même secret que BizaNet Control)
AGENT_JWT_SECRET=

# IPs autorisées (CSV). Vide = localhost uniquement. * = toutes (déconseillé en prod)
ALLOWED_IPS=127.0.0.1,::1

# MikroTik RouterOS API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_TLS=false

# Reconnexion
MIKROTIK_RECONNECT_MS=5000
HEARTBEAT_INTERVAL_MS=30000

# Profil par défaut tickets BN-XXXX
HOTSPOT_TOKEN_PROFILE=standar1
